rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Users ---
    // User profiles can be read by any client (for displaying names on invites and lists)
    // and written by authenticated users or during onboarding
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // --- Classrooms ---
    // Classrooms must be readable so invite links (/?join=CODE) and code lookups work for any user
    match /classrooms/{classroomId} {
      allow read: if true;
      allow create, update, delete: if true;
      
      // --- Classroom Members ---
      // Members sub-collection can be read and written by any client
      match /members/{userId} {
        allow read: if true;
        allow write: if true;
      }

      // --- Classroom Join Requests ---
      // Pending student registration requests for treasurer approval
      match /joinRequests/{userId} {
        allow read: if true;
        allow write: if true;
      }
    }
    
    // --- Payments ---
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }
    
    // --- Expenses ---
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if true;
    }
    
    // --- Cashout Requests ---
    match /cashoutRequests/{cashoutId} {
      allow read: if true;
      allow write: if true;
    }
    
    // --- Audit Logs ---
    match /auditLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

